# Local placeholders only. Never commit real credentials.
REPO_STEWARD_ENVIRONMENT=development
REPO_STEWARD_LOG_LEVEL=INFO
# Required in production (minimum 32 characters); sent as X-Repo-Steward-Key.
REPO_STEWARD_API_KEY=
REPO_STEWARD_MAX_REQUEST_BODY_BYTES=1048576
REPO_STEWARD_GITHUB_TOKEN=
REPO_STEWARD_GITHUB_API_URL=https://api.github.com
# Explicit comma-separated allow-list required by the owner analysis endpoint.
REPO_STEWARD_GITHUB_ALLOWED_OWNERS=
REPO_STEWARD_GITHUB_APP_ID=
REPO_STEWARD_GITHUB_PRIVATE_KEY_PATH=
REPO_STEWARD_GITHUB_PRIVATE_KEY=
REPO_STEWARD_GITHUB_WEBHOOK_SECRET=
REPO_STEWARD_GITHUB_REQUEST_TIMEOUT_SECONDS=10
REPO_STEWARD_GITHUB_OWNER_TIMEOUT_SECONDS=60
REPO_STEWARD_GITHUB_MAX_PAGES=20
REPO_STEWARD_GITHUB_MAX_TREE_REQUESTS=500
REPO_STEWARD_GITHUB_MAX_REPOSITORIES=500
REPO_STEWARD_GITHUB_MAX_REQUESTS=2000
REPO_STEWARD_GITHUB_MAX_RESPONSE_BYTES=2097152
REPO_STEWARD_GITHUB_MAX_TREE_ENTRIES=100000
REPO_STEWARD_GITHUB_MAX_QUEUED_TREES=10000
REPO_STEWARD_GITHUB_MAX_RETAINED_PATHS=100000
